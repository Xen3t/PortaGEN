# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local ne doit JAMAIS être commité.

# Clé API Google Gemini (génération d'images Nano Banana Pro + rôles LLM)
GEMINI_API_KEY=

# Modèles Gemini
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Clé API Anthropic (analyse moodboard + juge qualité, optionnel tant qu'absent)
ANTHROPIC_API_KEY=

# Racine du serveur de fichiers (chemin interne — valeur par défaut si le réglage Admin est vide)
SERVER_ROOT=
